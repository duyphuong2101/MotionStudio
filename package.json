{
  "name": "motion-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brief-to-video studio: an LLM director writes the script, a deterministic HTML + GSAP template renders it frame by frame.",
  "scripts": {
    "ui": "node server/server.mjs",
    "ui:review": "node server/server.mjs --review",
    "studio": "node engine/cli.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "onnxruntime-node": "^1.23.0",
    "phonemizer": "^1.2.1",
    "playwright-core": "1.64.0",
    "three": "0.186.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}

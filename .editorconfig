# EditorConfig — auto-generated by AI Config installer
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.{js,ts,vue,css,scss,json,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]

{
  "id": "logo-reveal",
  "label": "Logo reveal / sting",
  "marks": true,
  "help": {
    "kinds": { "reveal": "The brand logo revealed, with an optional tagline." },
    "fields": { "vo": "Optional voice line, 14 words at most. Leave empty for a silent sting." }
  },
  "description": "A short brand sting for the start or end of other videos: the brand logo (file or logo text) revealed by a drawn ring, a burst of rays or sliding color panels, then an optional tagline. The voice line is optional.",
  "formats": ["16:9", "1:1", "9:16", "4:5", "2:3", "21:9"],
  "sizes": { "16:9": [1920, 1080], "1:1": [1080, 1080], "9:16": [1080, 1920], "4:5": [1080, 1350], "2:3": [1080, 1620], "21:9": [2520, 1080] },
  "durations": [3, 10],
  "directors": ["seat", "claude", "gemini", "grok"],
  "sequence": [
    { "kind": ["reveal"], "min": 1, "max": 1 }
  ],
  "fields": {
    "reveal": { "required": [], "optional": ["vo", "tagline", "style", "theme", "url", "source", "pace", "sfx"] }
  },
  "limits": { "tagline": 50, "url": 40, "voWords": 14 },
  "enums": { "pace": ["quick", "normal", "focus"], "style": ["draw", "burst", "slide"], "theme": ["light", "dark"], "sfx": ["whoosh", "hit", "riser", "click", "none"] },
  "defaults": {
    "reveal": { "style": "draw", "theme": "dark", "tagline": "Your tagline here" }
  },
  "pace": {
    "quick": { "perShot": 3.0, "minScene": 3.0, "tail": 0.4 },
    "normal": { "perShot": 4.2, "minScene": 4.2 },
    "focus": { "perShot": 5.5, "minScene": 5.5, "tail": 1.0 }
  }
}

{
  "id": "social-teaser",
  "label": "Social teaser",
  "help": {
    "kinds": {
      "hero": "Opening shot: the product name and its pack image.",
      "stat": "The one benefit, told as a number, with the morphing icon.",
      "benefit": "The one benefit, told in words, with the morphing icon.",
      "cta": "Closing card: the one action viewers should take, with a button."
    },
    "fields": {
      "vo": "What the voice says in this scene: one short sentence (14 words at most).",
      "asset": "The product pack image.",
      "kicker": "A short label for the benefit, e.g. \"Absorbency\".",
      "cta.icon": "The icon the closing card ends on; it morphs from the benefit."
    }
  },
  "description": "A 6 to 15 second teaser for feeds and stories, built on the product demo renderer: the product hero, one stat or benefit with the morphing icon, then the call to action. Short lines only.",
  "formats": [
    "9:16"
  ],
  "marks": true,
  "durations": [
    6,
    15
  ],
  "directors": [
    "seat",
    "claude",
    "gemini",
    "grok"
  ],
  "sequence": [
    {
      "kind": [
        "hero"
      ],
      "min": 1,
      "max": 1
    },
    {
      "kind": [
        "stat",
        "benefit"
      ],
      "min": 1,
      "max": 1
    },
    {
      "kind": [
        "cta"
      ],
      "min": 1,
      "max": 1
    }
  ],
  "fields": {
    "hero": {
      "required": [
        "vo",
        "title",
        "source"
      ],
      "optional": [
        "subtitle",
        "asset",
        "packLine"
      ]
    },
    "stat": {
      "required": [
        "vo",
        "kicker",
        "stat",
        "text",
        "chip",
        "icon",
        "source"
      ],
      "optional": []
    },
    "benefit": {
      "required": [
        "vo",
        "kicker",
        "text",
        "chip",
        "icon",
        "source"
      ],
      "optional": [
        "decor",
        "check"
      ]
    },
    "cta": {
      "required": [
        "vo",
        "title",
        "button"
      ],
      "optional": [
        "url",
        "icon",
        "source"
      ]
    }
  },
  "limits": {
    "title": 30,
    "subtitle": 48,
    "kicker": 20,
    "text": 72,
    "chip": 26,
    "button": 22,
    "url": 40,
    "packLine": 32,
    "voWords": 14
  },
  "enums": {
    "decor": [
      "walls",
      "waves",
      "none"
    ]
  },
  "defaults": {
    "hero": { "title": "Product name" },
    "stat": { "kicker": "Key number", "stat": { "value": 12, "unit": "h" }, "text": "of protection", "chip": "Up to 12 hours", "icon": "drop" },
    "benefit": { "kicker": "Benefit", "text": "One line about this benefit", "chip": "Short tag", "icon": "shield" },
    "cta": { "title": "Try it today", "button": "Shop now" }
  },
  "extends": "product-demo"
}

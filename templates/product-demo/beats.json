{
  "id": "product-demo",
  "label": "Product demo",
  "help": {
    "kinds": {
      "hero": "Opening shot: the product name and its pack image.",
      "stat": "A benefit told as a number, with the morphing icon.",
      "benefit": "A benefit told in words, with the morphing icon.",
      "cta": "Closing card: the one action viewers should take, with a button."
    },
    "fields": {
      "asset": "The product pack image.",
      "kicker": "A short label for the benefit, e.g. \"Absorbency\".",
      "cta.icon": "The icon the closing card ends on; it morphs from the last benefit."
    }
  },
  "description": "Hero with the product pack, two or three benefits (stat or icon), then a call to action. One SVG icon morphs through every benefit and carries into the CTA.",
  "formats": ["9:16"],
  "marks": true,
  "durations": [10, 40],
  "directors": ["seat", "claude", "gemini"],
  "sequence": [
    { "kind": ["hero"], "min": 1, "max": 1 },
    { "kind": ["stat", "benefit"], "min": 2, "max": 3 },
    { "kind": ["cta"], "min": 1, "max": 1 }
  ],
  "fields": {
    "hero": { "required": ["vo", "title", "source"], "optional": ["subtitle", "asset", "packLine"] },
    "stat": { "required": ["vo", "kicker", "stat", "text", "chip", "icon", "source"], "optional": [] },
    "benefit": { "required": ["vo", "kicker", "text", "chip", "icon", "source"], "optional": ["decor", "check"] },
    "cta": { "required": ["vo", "title", "button"], "optional": ["url", "icon", "source"] }
  },
  "limits": {
    "title": 30,
    "subtitle": 48,
    "kicker": 20,
    "text": 72,
    "chip": 26,
    "button": 22,
    "url": 40,
    "packLine": 32,
    "voWords": 24
  },
  "enums": {
    "decor": ["walls", "waves", "none"]
  },
  "defaults": {
    "hero": { "title": "Product name" },
    "stat": { "kicker": "Key number", "stat": { "value": 12, "unit": "h" }, "text": "of protection", "chip": "Up to 12 hours", "icon": "drop" },
    "benefit": { "kicker": "Benefit", "text": "One line about this benefit", "chip": "Short tag", "icon": "shield" },
    "cta": { "title": "Try it today", "button": "Shop now" }
  }
}
